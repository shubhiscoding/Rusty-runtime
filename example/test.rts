let x = (2 + 3) * 4;
print "x = " + x;

function max(a, b) {
    if (a > b) {
        return a;
    } else {
        return b;
    }
}

print "max is " + max(x, 15);

function factorial(n) {
    if (n < 2) { return 1; }
    return n * factorial(n - 1);
}
print "5! = " + factorial(5);

for (let i = 0; i < 5; i++) {
    if (i == 2) { continue; }
    if (i == 4) { break; }
    print i;
}

